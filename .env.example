# Provide at least one provider key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Meta Model API key for Muse models (dev.meta.ai)
META_API_KEY=

# Model overrides (optional)
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5.3-codex
GEMINI_MODEL=gemini-3.8-flash
MUSE_MODEL=muse-spark-1.3

# Code runner: "docker" (default, sandboxed, no network) or "local" (uses host interpreters, no isolation)
DEFAANG_RUNNER=docker
# Per-run wall clock limit in seconds
DEFAANG_RUN_TIMEOUT=10

PORT=4317

# Teaching animations (animations/): ElevenLabs narration. Leave the key empty to render silent drafts.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_SPEED=1.0
