  ],
  "hidden": [
    {
      "name": "capacity one",
      "ops": ["LRUCache", "put", "get", "put", "get", "get"],
      "args": [[1], [2, 1], [2], [3, 2], [2], [3]],
      "expected": [null, null, 1, null, -1, 2]
    },
    {
      "name": "update refreshes recency",
      "ops": ["LRUCache", "put", "put", "put", "put", "get", "get"],
      "args": [[2], [2, 1], [1, 1], [2, 3], [4, 1], [1], [2]],
      "expected": [null, null, null, null, null, -1, 3]
    },
    {
      "name": "get refreshes recency",
      "ops": ["LRUCache", "put", "put", "get", "put", "get", "get", "get"],
      "args": [[2], [1, 10], [2, 20], [1], [3, 30], [2], [1], [3]],
      "expected": [null, null, null, 10, null, -1, 10, 30]
    },
    {
      "name": "update without eviction",
      "ops": ["LRUCache", "put", "put", "put", "get", "get"],
      "args": [[2], [1, 1], [2, 2], [1, 5], [1], [2]],
      "expected": [null, null, null, null, 5, 2]
    },
    {
      "name": "miss on empty",
      "ops": ["LRUCache", "get", "put", "get"],
      "args": [[3], [7], [7, 70], [7]],
      "expected": [null, -1, null, 70]
    }
  ]
